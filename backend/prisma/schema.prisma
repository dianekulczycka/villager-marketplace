generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model item {
  id          Int       @id @default(autoincrement())
  name        item_name
  price       Int
  count       Int
  description String?   @db.VarChar(255)
  iconUrl     String?   @db.VarChar(255)
  views       Int       @default(0)
  isDeleted   Int       @default(0) @db.TinyInt
  createdAt   DateTime  @default(now()) @db.DateTime(6)
  updatedAt   DateTime  @default(now()) @db.DateTime(6)
  sellerId    Int
  publicId    String    @unique @db.VarChar(8)
  seller      user      @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_7e5265b54c312941a5cef5a9379")
  orders      order[]

  @@index([sellerId], map: "FK_7e5265b54c312941a5cef5a9379")
}

model token {
  id                         Int      @id @default(autoincrement())
  accessToken                String   @db.VarChar(255)
  refreshToken               String   @db.VarChar(255)
  accessTokenExpirationTime  DateTime @db.DateTime(0)
  refreshTokenExpirationTime DateTime @db.DateTime(0)
  isBlocked                  Int      @default(0) @db.TinyInt
  jti                        String   @unique @db.VarChar(255)
  userId                     Int
  user                       user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_94f168faad896c0786646fa3d4a")

  @@index([userId], map: "FK_94f168faad896c0786646fa3d4a")
}

model user {
  id                Int              @id @default(autoincrement())
  email             String           @unique(map: "IDX_e12875dfb3b1d92d7d7c5377e2") @db.VarChar(255)
  password          String           @db.VarChar(255)
  username          String           @db.VarChar(255)
  role              user_role        @default(BUYER)
  iconUrl           String?          @db.VarChar(255)
  sellerType        user_sellerType?
  isBanned          Int              @default(0) @db.TinyInt
  bannedBy          String?          @db.VarChar(255)
  bannedAt          DateTime?        @db.DateTime(0)
  isFlagged         Int              @default(0) @db.TinyInt
  createdAt         DateTime         @default(now()) @db.DateTime(6)
  updatedAt         DateTime         @default(now()) @db.DateTime(6)
  isDeleted         Int              @default(0) @db.TinyInt
  deletedAt         DateTime?        @db.DateTime(0)
  deletedBy         String?          @db.VarChar(255)
  publicId          String           @unique @db.VarChar(8)
  item              item[]
  recipientMessages message[]        @relation("recipientMessages")
  senderMessages    message[]        @relation("senderMessages")
  buyerOrders       order[]          @relation("buyerOrders")
  sellerOrders      order[]          @relation("sellerOrders")
  token             token[]
}

model order {
  id        Int          @id @default(autoincrement())
  buyerId   Int
  sellerId  Int
  itemId    Int
  amount    Int
  status    order_status @default(PENDING)
  createdAt DateTime     @default(now()) @db.DateTime(6)
  publicId  String       @unique @db.VarChar(8)
  buyer     user         @relation("buyerOrders", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item      item         @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller    user         @relation("sellerOrders", fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([buyerId])
  @@index([sellerId])
  @@index([itemId])
}

model message {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  body        String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.DateTime(6)
  recipientId Int
  senderId    Int
  isRead      Boolean  @default(false)
  recipient   user     @relation("recipientMessages", fields: [recipientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sender      user     @relation("senderMessages", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([senderId])
  @@index([recipientId])
}

